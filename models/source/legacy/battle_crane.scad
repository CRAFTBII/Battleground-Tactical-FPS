// 龙门吊 (battle_crane) — 港口集装箱装卸区地标
// 轴: x=宽(26), y=深(10), z=高(16); 原点在角(0,0,0); 主梁沿 X 横跨
// 四门腿(截面 0.8, 高 14) + 桁架主梁(26×10×2) + 小车吊钩 + 司机室
// 腿间净空 14m 可通行, 主梁高空(≥14m)只挡弹道
// 碰撞契约: 四腿 0.8²×14 + 主梁 26×10×2 → GLB bbox 必须精确 26×10×16
$fn = 8;

module legs() {
  // 四门腿 (截面 0.8, 高 14, 放四角)
  for (y = [0, 9.2]) for (x = [0, 25.2]) {
    color([0.55, 0.42, 0.30]) translate([x, y, 0]) cube([0.8, 0.8, 14]);
  }
  // 腿底基座板 (防倒, 压在 bbox 内 0-26 × 0-10; 腿 y=9.2 → 基座 y 8.6-10.0 不超深 10)
  for (y = [0, 8.6]) for (x = [0, 24.6]) {
    color([0.50, 0.38, 0.28]) translate([x, y, 0]) cube([1.4, 1.4, 0.5]);
  }
}

module beam() {
  // 主梁 (26×10×2, z 14-16)
  color([0.65, 0.55, 0.38]) translate([0, 0, 14]) cube([26, 10, 2]);
  // 梁端封板
  color([0.60, 0.50, 0.34]) translate([0, 0, 14]) cube([0.4, 10, 2]);
  color([0.60, 0.50, 0.34]) translate([25.6, 0, 14]) cube([0.4, 10, 2]);
}

module trolley() {
  // 小车 (2.4×1.8×1.1) 挂主梁下 z 12.9-14
  color([0.50, 0.42, 0.34]) translate([11.8, 4.1, 12.9]) cube([2.4, 1.8, 1.1]);
  // 吊钩柱 (0.8×0.8×1.3, z 11.6-12.9)
  color([0.45, 0.38, 0.30]) translate([12.6, 4.6, 11.6]) cube([0.8, 0.8, 1.3]);
}

module cab() {
  // 司机室 (2×2×2) 挂主梁下 x 端, z 12-14
  color([0.45, 0.48, 0.55]) translate([0.6, 4, 12]) cube([2, 2, 2]);
  // 司机室窗 (朝 y=+深面)
  color([0.55, 0.72, 0.85]) translate([0.55, 4.15, 12.5]) cube([0.15, 1.4, 1.2]);
  // 雨檐
  color([0.40, 0.42, 0.48]) translate([0.6, 3.8, 13.9]) cube([2.2, 2.4, 0.15]);
}

legs();
beam();
trolley();
cab();

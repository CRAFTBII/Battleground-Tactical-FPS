// 桁架天线塔 (battle_mast) — 荒漠通讯/观察制高点
// 轴: x=宽(6), y=深(6), z=高(20); 原点在角(0,0,0)
// 四主柱(0.5²×19.5) + 每 4m 横撑(4 层) + 顶部平台(0.5) → z 顶=20
// 柱间可通行, 平台可攀(制高点)
// 碰撞契约: 四柱 0.5²×20 + 顶部平台 → GLB bbox 必须精确 6×6×20
$fn = 6;

module columns() {
  // 四主柱 (截面 0.5, 高 19.5; 顶部 0.5 由平台补齐 → z 20)
  for (y = [0, 5.5]) for (x = [0, 5.5]) {
    color([0.45, 0.40, 0.36]) translate([x, y, 0]) cube([0.5, 0.5, 19.5]);
  }
}

module braces() {
  // 每 4m 一层横撑 (4 层: z 4/8/12/16, 厚 0.3)
  for (z = [4, 8, 12, 16]) {
    color([0.42, 0.37, 0.33]) translate([0, 0, z]) cube([6, 0.3, 0.3]);
    color([0.42, 0.37, 0.33]) translate([0, 5.7, z]) cube([6, 0.3, 0.3]);
    color([0.42, 0.37, 0.33]) translate([0, 0, z]) cube([0.3, 6, 0.3]);
    color([0.42, 0.37, 0.33]) translate([5.7, 0, z]) cube([0.3, 6, 0.3]);
    // 每层交叉斜撑 (对角 2 根, 细条)
    color([0.40, 0.35, 0.31]) translate([1, 0, z]) cube([0.2, 0.2, 3.2]);
    color([0.40, 0.35, 0.31]) translate([1, 5.8, z]) cube([0.2, 0.2, 3.2]);
    color([0.40, 0.35, 0.31]) translate([0, 1, z]) cube([0.2, 0.2, 3.2]);
    color([0.40, 0.35, 0.31]) translate([5.8, 1, z]) cube([0.2, 0.2, 3.2]);
  }
}

module platform() {
  // 顶部平台 (6×6×0.5, z 19.5-20)
  color([0.50, 0.46, 0.40]) translate([0, 0, 19.5]) cube([6, 6, 0.5]);
}

columns();
braces();
platform();
